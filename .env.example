# Copy to .env for local use, or set these as environment variables when deploying.
# Real environment variables take precedence over .env. All settings are optional.

# OpenAI key used when a visitor doesn't enter their own (server-side only).
OPENAI_API_KEY=

# Ollama server address. Default: http://localhost:11434
# From inside Docker, use e.g. http://host.docker.internal:11434
OLLAMA_BASE_URL=

# User accounts: set a MongoDB connection string (e.g. from MongoDB Atlas:
# Connect -> Drivers -> mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/).
# When set, people sign up / sign in and each user's papers are saved to their
# account. Leave empty for no accounts.
MONGODB_URI=
# Database name inside that cluster. Default: examforge
MONGODB_DB=
# Per-user cap on AI requests per hour (accounts only). Default: 30
EXAMFORGE_MAX_AI_REQUESTS_PER_USER_PER_HOUR=

# Shared password for the whole app (only used when MONGODB_URI is empty).
# Set this before exposing the app publicly without accounts.
EXAMFORGE_PASSWORD=

# App-wide cap on AI requests per hour that use the server's OpenAI key or Ollama.
# Visitors using their own OpenAI key aren't counted. 0 = unlimited. Default: 120
EXAMFORGE_MAX_AI_REQUESTS_PER_HOUR=

# Seconds before a single AI request times out. Default: 120
EXAMFORGE_LLM_TIMEOUT=

# Limits on the marks table. Defaults: 50 questions, 100 marks per question.
EXAMFORGE_MAX_QUESTIONS=
EXAMFORGE_MAX_MARKS_PER_QUESTION=
